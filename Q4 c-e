**********ESTIMATE PARETO SHAPE OF THE PRODUCTIVITY DISTRIBUTION


sort sector year
by sector year: cumul TFP_LP, generate(cum_TFP_LP)
gen rhs_LP=log(1- cum_TFP_LP)


*** first we pool all the years together and evaluate the general shape of the distribution
*then we compare the k-value for initial and final year to check the evolution of the distribution

foreach s in 13 29{
qui reg rhs_LP ln_TFP_LP if sector==`s' & year==2006
outreg2 using Pareto.xls, append title("Pareto Distribution") ctitle("Sector `s' - 2006")
qui reg rhs_LP ln_TFP_LP if sector==`s' & year==2015
outreg2 using Pareto.xls, append title("Pareto Distribution") ctitle("Sector `s' - 2015")
qui reg rhs_LP ln_TFP_LP if sector==`s' & year==2006 & country=="France"
outreg2 using Pareto.xls, append title("Pareto Distribution") ctitle("Sector `s' - 2006 - France")
qui reg rhs_LP ln_TFP_LP if sector==`s' & year==2015 & country=="France"
outreg2 using Pareto.xls, append title("Pareto Distribution") ctitle("Sector `s' - 2015 - France")
qui reg rhs_LP ln_TFP_LP if sector==`s' & year==2006 & country=="Spain"
outreg2 using Pareto.xls, append title("Pareto Distribution") ctitle("Sector `s' - 2006 - Spain")
qui reg rhs_LP ln_TFP_LP if sector==`s' & year==2015 & country=="Spain"
outreg2 using Pareto.xls, append title("Pareto Distribution") ctitle("Sector `s' - 2015 - Spain")
}




