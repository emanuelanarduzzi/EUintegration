* create variables

gen ln_real_K=ln(real_K)
gen ln_L=ln(L)
gen ln_real_VA=ln(real_VA)
gen ln_real_M=ln(real_M)

* generate TFP estimates with OLS for France, Spain in sector 13 & 29

xi: reg ln_real_VA ln_L ln_real_K i.country i.year if sector==13 & inlist(country,"France","Spain")
predict ln_TFP_OLS_13, residuals
gen TFP_OLS_13= exp(ln_TFP_OLS_13)
sum TFP_OLS_13, d
replace TFP_OLS_13=. if !inrange(TFP_OLS_13,r(p1),r(p99))
kdensity TFP_OLS_13
sum ln_TFP_OLS_13, d
